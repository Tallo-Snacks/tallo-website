# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.

# Database (Supabase project "tallo"): Project Settings > API Keys
SUPABASE_URL=https://kjhfxyungqjwnychawsz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Stripe): Developers > API keys, and Developers > Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to true to let Stripe calculate sales tax (needs Stripe Tax turned on)
STRIPE_TAX=false

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Tallo <orders@yourdomain.com>

# Turn the shop on (true) or keep showing the waitlist (false)
NEXT_PUBLIC_STORE_OPEN=false
NEXT_PUBLIC_SITE_URL=https://tallo-website.vercel.app
